# Line endings and diff behavior.
* text=auto
*.sh text eol=lf
*.ps1 text eol=crlf
*.rs text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
# Frozen benchmark JSON participates in raw-byte provenance hashes.
tests/fixtures/search-bench/*.json text eol=lf
Cargo.lock text eol=lf
# Frontend formatter and generated contract bytes are identical on native runners.
*.svelte text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
.node-version text eol=lf
.npmrc text eol=lf
