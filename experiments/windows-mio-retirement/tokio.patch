+    /// Construct a pipe retaining application accounting through native retirement.
+    ///
+    /// # Safety
+    /// The raw-handle ownership contract is the same as from_raw_handle.
+    ///
+    /// # Errors
+    /// Returns registration/runtime errors, retaining the guard through cleanup.
+    pub unsafe fn from_raw_handle_with_retirement_guard(
+        handle: RawHandle,
+        guard: Box<dyn Send + Sync>,
+    ) -> io::Result<Self> {
+        let named_pipe = unsafe {
+            mio_windows::NamedPipe::from_raw_handle_with_retirement_guard(handle, guard)
+        };
+        Ok(Self { io: PollEvented::new(named_pipe)? })
+    }
+
@@ -922,2 +939,10 @@
-    fn poll_flush(self: Pin<&mut Self>, _cx: &mut Context<'_>) -> Poll<io::Result<()>> {
-        Poll::Ready(Ok(()))
+    fn poll_flush(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        let mut pipe = &*self.io;
+        match std::io::Write::flush(&mut pipe) {
+            Err(error) if error.kind() == io::ErrorKind::WouldBlock => {}
+            result => return Poll::Ready(result),
+        }
+        self.io.registration().poll_write_io(cx, || {
+            let mut pipe = &*self.io;
+            std::io::Write::flush(&mut pipe)
+        })
